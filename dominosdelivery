<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#E31837">
<title>Domino's Estafetas</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght=600;700;900&family=Barlow:wght=400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --red: #E31837;
  --blue: #006491;
  --dark: #1a1a2e;
  --card: #16213e;
  --card2: #0f3460;
  --border: #2a2a4a;
  --text: #f0f0f0;
  --muted: #777;
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; }
body { background: var(--dark); color: var(--text); font-family: 'Barlow', sans-serif; min-height: 100dvh; overscroll-behavior: none; }

/* ── HEADER ── */
.header {
  background: linear-gradient(135deg, #E31837 0%, #b01020 100%);
  padding: 16px 16px 14px;
  display: flex; align-items: center; gap: 12px;
  position: sticky; top: 0; z-index: 50;
  box-shadow: 0 4px 24px rgba(227,24,55,0.4);
}
.logo-wrap { flex-shrink: 0; }
.logo-svg { width: 46px; height: 46px; display: block; }
.header-text { flex: 1; }
.header-title { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 24px; color: #fff; line-height: 1; letter-spacing: 0.5px; }
.header-title span { color: #FFD700; }
.header-sub { font-size: 11px; color: rgba(255,255,255,0.65); margin-top: 3px; letter-spacing: 0.3px; }
.header-badge {
  background: rgba(0,0,0,0.25); color: #fff;
  font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 14px;
  padding: 5px 12px; border-radius: 20px; white-space: nowrap; border: 1px solid rgba(255,255,255,0.2);
}

/* ── MAIN ── */
.main { padding: 18px 14px 200px; max-width: 500px; margin: 0 auto; }

/* ── ACTION BUTTONS ── */
.action-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
.action-btn {
  border: none; border-radius: 16px; padding: 18px 12px;
  cursor: pointer; position: relative; overflow: hidden;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  transition: transform 0.15s, box-shadow 0.15s;
  text-align: center;
}
.action-btn:active { transform: scale(0.95); }
.action-btn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; font-size: 0; }
.action-btn.camera { background: linear-gradient(135deg, var(--red), #b01020); box-shadow: 0 4px 20px rgba(227,24,55,0.35); }
.action-btn.gallery { background: linear-gradient(135deg, var(--blue), #004a6e); box-shadow: 0 4px 20px rgba(0,100,145,0.35); }
.action-btn-icon { font-size: 32px; line-height: 1; }
.action-btn-label { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 15px; color: #fff; letter-spacing: 0.5px; }
.action-btn-sub { font-size: 11px; color: rgba(255,255,255,0.7); }

/* ── ORIGIN CARD ── */
.origin-card {
  background: var(--card); border: 1px solid #0d3a52;
  border-radius: 14px; padding: 12px 16px;
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 16px;
}
.origin-icon { font-size: 28px; flex-shrink: 0; }
.origin-info { flex: 1; }
.origin-label { font-size: 10px; color: #4a9fc0; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 2px; }
.origin-name { font-size: 14px; color: #aad4e8; font-weight: 600; }
.origin-dot { width: 8px; height: 8px; background: #4CAF50; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 8px #4CAF50; animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.5)} }

/* ── ANALYZING ── */
.analyzing {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 16px; padding: 28px 20px; text-align: center;
  margin-bottom: 16px; animation: fadeIn 0.3s ease;
}
.spinner-wrap { position: relative; width: 48px; height: 48px; margin: 0 auto 14px; }
.spinner-ring { width: 48px; height: 48px; border: 3px solid rgba(227,24,55,0.15); border-top-color: var(--red); border-radius: 50%; animation: spin 0.8s linear infinite; position: absolute; }
.spinner-dot { width: 12px; height: 12px; background: var(--red); border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); }
@keyframes spin { to { transform: rotate(360deg); } }
.analyzing-title { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 20px; color: #fff; letter-spacing: 0.5px; }
.analyzing-sub { font-size: 12px; color: var(--muted); margin-top: 5px; }

/* ── EMPTY ── */
.empty { text-align: center; padding: 40px 20px; }
.empty-icon { font-size: 64px; display: block; margin-bottom: 16px; }
.empty-title { font-family: 'Barlow Condensed', sans-serif; font-size: 22px; font-weight: 900; color: #fff; margin-bottom: 8px; letter-spacing: 0.5px; }
.empty-sub { font-size: 13px; color: #ccc; line-height: 1.7; }

/* ── DELIVERIES ── */
.deliveries-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12px; padding: 0 2px;
}
.deliveries-title { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 18px; color: #fff; letter-spacing: 0.5px; }
.deliveries-count { font-size: 12px; color: var(--muted); background: var(--card2); padding: 3px 10px; border-radius: 20px; border: 1px solid var(--border); }

.deliveries-list { display: flex; flex-direction: column; gap: 0; position: relative; }

/* Linha da Linha do Tempo */
.deliveries-list::before {
  content: ''; position: absolute;
  left: 20px; top: 40px; bottom: 40px;
  width: 2px; background: linear-gradient(to bottom, var(--red), var(--blue));
  opacity: 0.3; border-radius: 2px;
}

.delivery-item {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 10px 0; position: relative;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }

.delivery-num {
  width: 42px; height: 42px; flex-shrink: 0;
  background: var(--card2); border: 2px solid var(--border);
  border-radius: 50%; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  font-family: 'Barlow Condensed', sans-serif; font-weight: 900;
  z-index: 1; transition: all 0.2s;
}
.delivery-num .num-label { font-size: 9px; color: var(--muted); line-height: 1; text-transform: uppercase; letter-spacing: 0.5px; }
.delivery-num .num-val { font-size: 14px; color: #fff; line-height: 1; margin-top: 1px; }
.delivery-item:first-child .delivery-num { background: #1a0005; border-color: var(--red); }
.delivery-item:first-child .delivery-num .num-val { color: var(--red); }
.delivery-item:last-child .delivery-num { background: #001a24; border-color: var(--blue); }
.delivery-item:last-child .delivery-num .num-val { color: #4a9fc0; }

.delivery-card {
  flex: 1; background: var(--card); border: 1px solid var(--border);
  border-radius: 14px; padding: 12px 14px;
  transition: border-color 0.2s;
}
.delivery-card:hover { border-color: #333; }
.delivery-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
.delivery-order-num {
  font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 12px;
  color: var(--red); background: #1a0005; padding: 2px 8px;
  border-radius: 20px; border: 1px solid #3a0010; white-space: nowrap; flex-shrink: 0;
}
.btn-del { background: none; border: none; color: #555; font-size: 18px; cursor: pointer; line-height: 1; padding: 0 2px; transition: color 0.15s; flex-shrink: 0; }
.btn-del:hover { color: var(--red); }
.delivery-addr { font-size: 14px; color: var(--text); line-height: 1.5; font-weight: 500; word-break: break-word; }
.delivery-addr.editing { display: none; }
.edit-input { background: #12122a; border: 1px solid var(--red); color: #fff; font-family: 'Barlow', sans-serif; font-size: 13px; padding: 8px 10px; border-radius: 8px; width: 100%; outline: none; margin-top: 4px; }
.delivery-actions { display: flex; gap: 6px; margin-top: 8px; }
.btn-sm { background: none; border: 1px solid var(--border); color: #999; font-family: 'Barlow', sans-serif; font-size: 11px; padding: 4px 10px; border-radius: 6px; cursor: pointer; transition: all 0.15s; }
.btn-sm:hover { border-color: #555; color: #ccc; }
.btn-sm.save { border-color: #1a3a1a; color: #4CAF50; }

/* ── GROUPS ── */
.groups-list { display: flex; flex-direction: column; gap: 12px; }
.group-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; animation: slideUp 0.25s ease; }
.group-card-header { padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.group-driver { display: flex; align-items: center; gap: 10px; }
.group-avatar { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
.group-name { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 16px; color: #fff; letter-spacing: 0.3px; }
.group-orders-label { font-size: 11px; color: var(--muted); margin-top: 1px; }
.btn-open-maps { border: none; border-radius: 10px; color: #fff; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 14px; padding: 8px 14px; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.15s; white-space: nowrap; flex-shrink: 0; }
.btn-open-maps:active { transform: scale(0.95); }
.group-stops { border-top: 1px solid var(--border); }
.group-stop { display: flex; align-items: flex-start; gap: 12px; padding: 11px 16px; border-bottom: 1px solid #161616; }
.group-stop:last-child { border-bottom: none; }
.group-stop-num { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 11px; flex-shrink: 0; margin-top: 2px; }
.group-stop-addr { font-size: 13px; color: #ccc; line-height: 1.5; flex: 1; word-break: break-word; }

/* ── TABS ── */
.tabs { display: flex; gap: 6px; margin-bottom: 16px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 4px; }
.tab { flex: 1; padding: 9px 6px; text-align: center; cursor: pointer; border-radius: 9px; transition: all 0.2s; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; color: var(--muted); letter-spacing: 0.3px; }
.tab.active { background: var(--card2); color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.4); }

/* ── BOTTOM BAR ── */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 12px 14px 20px; background: linear-gradient(to top, #1a1a2e 55%, transparent); z-index: 40; }
.bottom-inner { max-width: 500px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }

.btn-main {
  width: 100%; border: none; border-radius: 16px; color: #fff;
  font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 20px;
  letter-spacing: 0.5px; padding: 18px 20px; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 12px;
  transition: all 0.15s;
}
.btn-main.maps { background: linear-gradient(135deg, var(--blue), #004a6e); box-shadow: 0 4px 20px rgba(0,100,145,0.4); }
.btn-main.maps:disabled { background: #1a1a1a; color: #444; box-shadow: none; cursor: not-allowed; }
.btn-main.maps:not(:disabled):active { transform: scale(0.97); }
.btn-main.group { background: linear-gradient(135deg, #2a5a00, #1a3a00); box-shadow: 0 4px 16px rgba(42,90,0,0.3); }
.btn-main.group:disabled { background: #1a1a1a; color: #444; box-shadow: none; cursor: not-allowed; }
.btn-main.group:not(:disabled):active { transform: scale(0.97); }

.btn-secondary { width: 100%; background: none; border: 1px solid var(--border); border-radius: 10px; color: #555; font-family: 'Barlow', sans-serif; font-size: 13px; padding: 10px; cursor: pointer; transition: all 0.15s; }
.btn-secondary:hover { border-color: var(--red); color: var(--red); }

/* TOAST */
.toast { position: fixed; top: 80px; left: 50%; transform: translateX(-50%) translateY(-12px); background: #fff; color: #000; font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: 100px; z-index: 300; opacity: 0; transition: all 0.25s; pointer-events: none; white-space: nowrap; }
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* STORE SELECTOR - GRID STYLE */
.store-selector-wrap { margin-bottom: 16px; }
.store-selector-label { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: #555; margin-bottom: 8px; padding: 0 2px; }
.store-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.store-btn {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 10px; padding: 10px 12px;
  cursor: pointer; transition: all 0.2s; text-align: left;
}
.store-btn.active { background: #1a0005; border-color: var(--red); }
.store-btn-name { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 14px; color: #ccc; }
.store-btn.active .store-btn-name { color: var(--red); }
.store-btn-city { font-size: 11px; color: #555; margin-top: 2px; }
.store-btn.active .store-btn-city { color: #a44; }
</style>
</head>
<body>

<div class="header">
  <div class="logo-wrap">
    <img src="data:image/png;base64,
